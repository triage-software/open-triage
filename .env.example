# Copy to .env.local. Server-only settings; never use a NEXT_PUBLIC_ prefix.
TRIAGE_IMAP_HOST=mail.example.com
TRIAGE_IMAP_PORT=993
TRIAGE_IMAP_USER=support@example.com
TRIAGE_IMAP_PASSWORD=
TRIAGE_IMAP_SENT_FOLDER=SENT
TRIAGE_SMTP_HOST=mail.example.com
TRIAGE_SMTP_PORT=465
TRIAGE_SMTP_USER=support@example.com
# Leave empty to use TRIAGE_IMAP_PASSWORD for the same shared account.
TRIAGE_SMTP_PASSWORD=
