# Required
SESSION_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=opentriage

# Optional
WEB_PORT=3000
APP_URL=http://localhost:3000
VIKINGDB_URL=http://vikingdb:1933
OPENROUTER_API_KEY=
# Worker (mail/AI slice): poll interval for IMAP polling (default 30000 ms)
WORKER_POLL_INTERVAL_MS=30000
# System e-mail transport (invite / verification mail). When unset, the API
# falls back to the MVP behavior (setupToken in the invite response, verify
# token in server logs).
SMTP_SYSTEM_HOST=
SMTP_SYSTEM_PORT=587
SMTP_SYSTEM_SECURE=false
SMTP_SYSTEM_USER=
SMTP_SYSTEM_PASSWORD=
SMTP_SYSTEM_FROM=
